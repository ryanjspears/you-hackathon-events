# You.com (https://you.com/platform/api-keys)
YDC_API_KEY=
# Daytona (https://app.daytona.io/dashboard/keys) — only needed for the SDK fallback; the app goes through One
DAYTONA_API_KEY=
# One (https://app.withone.ai/settings/api-keys) — same key the `one` CLI uses
ONE_SECRET=
# Comma-separated connection keys from `one --agent list` (you + daytona)
ONE_CONNECTION_KEYS=
# LLM for the CrewAI agents (default model openai/gpt-4o; override with CREW_MODEL, e.g. anthropic/claude-sonnet-5 + ANTHROPIC_API_KEY)
OPENAI_API_KEY=
# Per-request tracing ([trace] lines + `trace` SSE events + done.trace); set to 0 to turn it off
TRACE=1
